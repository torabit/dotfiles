# 生成物。編集は theme.conf.in を直す。

background = {{role.bg}}
foreground = {{role.fg}}

# ANSI 16 色。PaperColor は ANSI スロットの意味を守らないため role ではなく ansi で参照する
palette = 0={{ansi.0}}
palette = 1={{ansi.1}}
palette = 2={{ansi.2}}
palette = 3={{ansi.3}}
palette = 4={{ansi.4}}
palette = 5={{ansi.5}}
palette = 6={{ansi.6}}
palette = 7={{ansi.7}}
palette = 8={{ansi.8}}
palette = 9={{ansi.9}}
palette = 10={{ansi.10}}
palette = 11={{ansi.11}}
palette = 12={{ansi.12}}
palette = 13={{ansi.13}}
palette = 14={{ansi.14}}
palette = 15={{ansi.15}}

cursor-color = {{role.fg}}
cursor-text = {{role.bg}}

# 選択範囲は alacritty と同じくセル単位の反転にする
selection-foreground = cell-background
selection-background = cell-foreground

# 検索ハイライト
search-foreground = {{role.bg}}
search-background = {{role.error}}
search-selected-foreground = {{role.bg}}
search-selected-background = {{role.visual}}
