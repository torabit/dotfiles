-- 生成物。編集は vanadis の templates/neovim/palette.lua.in を直す。
return {
	-- 色ではない 2 つ。plugins/colorscheme.lua が読む。
	-- variant は &background に、colorscheme は :colorscheme に渡る。
	-- ここを経由させないと、dark を適用しても nvim だけ light のまま残る。
	variant = "{{meta.variant}}",
	colorscheme = "{{text.nvim-colorscheme}}",

	bg = "{{role.bg}}",
	fg = "{{role.fg}}",
	error = "{{role.error}}",
	warn = "{{role.warn}}",
	visual = "{{role.visual}}",
	comment = "{{role.comment}}",
	border = "{{role.border}}",
	accent = "{{role.accent}}",
	brown = "{{colors.brown}}",
	slate = "{{colors.slate}}",
}
