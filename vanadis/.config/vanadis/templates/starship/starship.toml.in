# 生成物。編集は vanadis の templates/starship/starship.toml.in を直す。
"$schema" = 'https://starship.rs/config-schema.json'

format = """
$username\
$hostname\
$directory\
$git_branch\
$git_state\
$git_status\
$cmd_duration\
$line_break\
$python\
$character"""

palette = "vanadis"

[palettes.vanadis]
accent-alt = "{{role.accent-alt}}"
accent-warm = "{{role.accent-warm}}"
comment = "{{role.comment}}"
error = "{{role.error}}"
ok = "{{role.ok}}"
warn = "{{role.warn}}"
purple = "{{colors.purple}}"
visual = "{{role.visual}}"

# style を書かないと starship の既定 (bold yellow / bold dimmed green) に落ちる。
# 既定は ANSI の 16 色名で、端末側のパレットを引くのでテーマを切り替えても動かない。
# 区切りの " in " も、書式に色を付けないと端末の既定前景色のままになる。
[username]
format = "[$user]($style)[ in ](comment)"
style_user = "warn"
style_root = "error"

[hostname]
format = "[$ssh_symbol$hostname]($style)[ in ](comment)"
style = "ok"

[directory]
style = "visual"

[character]
success_symbol = "[❯](purple)"
error_symbol = "[❯](error)"
vimcmd_symbol = "[❮](ok)"

[git_branch]
format = "[$branch]($style)"
style = "comment"

[git_status]
format = "[[(*$conflicted$untracked$modified$staged$renamed$deleted)](accent-warm) ($ahead_behind$stashed)]($style)"
style = "accent-alt"
conflicted = ""
untracked = ""
modified = ""
staged = ""
renamed = ""
deleted = ""
stashed = "≡"

[git_state]
format = '\([$state( $progress_current/$progress_total)]($style)\) '
style = "comment"

[cmd_duration]
format = "[$duration]($style) "
style = "accent-alt"

[python]
format = "[$virtualenv]($style) "
style = "comment"
detect_extensions = []
detect_files = []
