# 生成物。編集は vanadis の templates/rio/theme.toml.in を直す。
#
# Rio の theme ファイル。config.toml の theme = "vanadis" がこれを引く。
# Rio が差し替えるのは colors だけで、fonts や bindings には触らない
# (rio-backend/src/config/theme.rs の Theme)。
#
# Rio は Windows ネイティブアプリなので、これを置くだけでは効かない。
# rio-sync が config.toml と一緒に %LOCALAPPDATA%\rio\ へ送る。

[colors]
background = "{{role.bg}}"
foreground = "{{role.fg}}"
cursor = "{{role.fg}}"
# vi モードのカーソルは通常カーソルと区別できるようアクセント色にする
# (Alacritty では CellForeground 反転指定だが Rio は固定色のみ)
vi-cursor = "{{role.accent-alt}}"

# 選択範囲: Alacritty の CellBackground / CellForeground 反転相当
selection-foreground = "{{role.bg}}"
selection-background = "{{role.fg}}"

# ANSI 16 colors。ANSI スロットの割り当てそのものを書く場所なので role.* は
# 経由しない。role を挟むと、role の再割り当てでスロットの意味が黙って変わる。
black = "{{ansi.0}}"
red = "{{ansi.1}}"
green = "{{ansi.2}}"
yellow = "{{ansi.3}}"
blue = "{{ansi.4}}"
magenta = "{{ansi.5}}"
cyan = "{{ansi.6}}"
white = "{{ansi.7}}"

light-black = "{{ansi.8}}"
light-red = "{{ansi.9}}"
light-green = "{{ansi.10}}"
light-yellow = "{{ansi.11}}"
light-blue = "{{ansi.12}}"
light-magenta = "{{ansi.13}}"
light-cyan = "{{ansi.14}}"
light-white = "{{ansi.15}}"

# 検索ハイライト
search-match-foreground = "{{role.bg}}"
search-match-background = "{{role.error}}"
search-focused-match-foreground = "{{role.bg}}"
search-focused-match-background = "{{role.visual}}"

# ヒント (URL 選択)
hint-foreground = "{{role.bg}}"
hint-background = "{{role.visual}}"

# UI: Rio 既定はダーク配色なので、light なテーマでも必ず上書きする
bar = "{{role.bg}}"
tabs = "{{role.border}}"
tabs-active = "{{role.accent}}"
split = "{{role.border}}"
