#!/usr/bin/env bash
#
# Windows のクリップボードにある画像を ssh 先へ転送し、リモート側の絶対パスを表示する。
#
# 用途: ssh 先で動かしている Claude Code へ画像を渡す。ローカルの Claude Code は
# 貼り付けで受け取れるが、ssh 先のプロセスは Windows のクリップボードに触れない。
#
# Windows のクリップボードは powershell.exe 経由で読む。WSL 側の xclip や
# wl-clipboard は WSL 内のクリップボードを指すので Windows 側の内容は取れない。
# 画像は PNG に変換して base64 で受け取る。
#
# 使い方:
#   clip-image           # 既定のホストへ転送
#   clip-image myhost    # ホストを指定
#
# 環境変数:
#   CLIP_IMAGE_HOST        転送先ホスト (既定: lura)
#   CLIP_IMAGE_REMOTE_DIR  リモートの保存先。ホーム基準の相対パス
#                          (既定: .cache/clip-image)
#   CLIP_IMAGE_KEEP_DAYS   リモートに残す日数。転送のついでに古い分を消すので
#                          cron は要らない (既定: 30)

set -euo pipefail

host="${1:-${CLIP_IMAGE_HOST:-lura}}"
remote_dir="${CLIP_IMAGE_REMOTE_DIR:-.cache/clip-image}"
keep_days="${CLIP_IMAGE_KEEP_DAYS:-30}"

powershell_exe=/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
if [[ ! -x "${powershell_exe}" ]]; then
  powershell_exe="$(command -v powershell.exe || true)"
fi
if [[ -z "${powershell_exe}" ]]; then
  echo "error: powershell.exe が見つかりません。WSL 上で実行してください。" >&2
  exit 1
fi

# Clipboard.GetImage は STA アパートメントでないと null を返すため -Sta を付ける。
# 画像が無い場合は exit 2 になるので、失敗を吸収して空文字列で判定する。
read -r -d '' ps_script <<'PS' || true
$ErrorActionPreference = 'Stop'
Add-Type -AssemblyName System.Windows.Forms, System.Drawing
$img = [Windows.Forms.Clipboard]::GetImage()
if (-not $img) { exit 2 }
$ms = New-Object System.IO.MemoryStream
$img.Save($ms, [System.Drawing.Imaging.ImageFormat]::Png)
[Convert]::ToBase64String($ms.ToArray())
PS

b64="$( { "${powershell_exe}" -NoProfile -Sta -Command "${ps_script}" 2>/dev/null || true; } | tr -d '\r\n' )"

if [[ -z "${b64}" ]]; then
  echo "error: クリップボードに画像がありません。" >&2
  exit 1
fi

name="clip-$(date +%Y%m%d-%H%M%S).png"
remote_path="${remote_dir}/${name}"

# 転送のついでに古い分を消す。溜まり続けるのを防ぐためで、これがあるので
# リモート側に cron を置かなくて済む。掃除の失敗は転送結果に影響させない。
prune="find '${remote_dir}' -maxdepth 1 -type f -name 'clip-*.png' -mtime +${keep_days} -delete 2>/dev/null || true"

# 転送、絶対パスの取得、掃除を 1 回の ssh で済ませる。
remote_cmd="mkdir -p '${remote_dir}' && cat > '${remote_path}' && readlink -f '${remote_path}' && { ${prune}; }"

# ssh config の LocalForward はファイル転送に不要。既存の ssh セッションと
# ポートが衝突して "Address already in use" を出すため無効にする。
abs="$(printf '%s' "${b64}" | base64 -d | ssh -o ClearAllForwardings=yes "${host}" "${remote_cmd}")"

# 転送先のパスを Windows のクリップボードへ入れ替える。ssh 先の Claude Code へ渡すのは
# 画像ではなくこのパスなので、そのまま Ctrl+V で貼り付けられる。
# 画像自体は転送済みなのでクリップボードに残す必要がない。
"${powershell_exe}" -NoProfile -Sta -Command "Set-Clipboard -Value '${abs}'" 2>/dev/null || true

echo "${abs}"
